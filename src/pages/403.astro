---
export const prerender = false
const title = "Unauthorized"
const message = "You don't have permission to access this page. Contact the LebendeMoge if you think this is a mistake"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <main class="page">
      <div class="card">
        <div class="icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M12 15v2" />
            <path d="M12 7v4" />
            <circle cx="12" cy="12" r="10" />
          </svg>
        </div>

        <p class="code">403</p>
        <h1>{title}</h1>
        <p class="message">{message}</p>
      </div>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at top, #e0e7ff 0%, transparent 35%),
      #f8fafc;
    color: #0f172a;
  }

  .page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
  }

  .card {
    width: min(100%, 420px);
    text-align: center;
    padding: 3rem 2.5rem;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(12px);
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    box-shadow:
      0 20px 50px rgba(15, 23, 42, 0.08),
      0 2px 8px rgba(15, 23, 42, 0.04);
  }

  .icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fee2e2;
    color: #dc2626;
  }

  .icon svg {
    width: 32px;
    height: 32px;
  }

  .code {
    margin: 0;
    font-size: 4.5rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.08em;
    color: #cbd5e1;
  }

  h1 {
    margin: 1rem 0 0.75rem;
    font-size: 2rem;
    letter-spacing: -0.04em;
  }

  .message {
    margin: 0 auto;
    max-width: 280px;
    color: #64748b;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .button {
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: #0f172a;
    color: white;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .button:hover {
    background: #1e293b;
    transform: translateY(-1px);
  }

  .link {
    color: #475569;
    text-decoration: none;
    font-weight: 500;
  }

  .link:hover {
    color: #0f172a;
  }
</style>
