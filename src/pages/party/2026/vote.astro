---
export const prerender = false;
import DefaultLayout from "../../../layouts/Default.astro";
import { Vote } from "../../../components/party/2026/Vote";
import { actions } from "astro:actions";

const restaurants = [
	"Dao",
	"Taste Kitchen",
	"Pho hanoi",
	"Lillys Kitchen",
	"Miyako Ramen",
	"Scechuan Impressions",
	"Ebisu Sushi",
	"Ichigo Ichie",
	"La Ruffa",
	"Surace",
	"Losteria",
	"Donauwirtinnen (Pizza)",
	"Casa Corrado",
	"Sorbas",
	"Tamu Sana",
	"Ayam zaman",
	"Bratwurst Glöckerl",
	"Station 183",
	"Le Burger",
	"Glorious Bastard",
	"Front Food",
	"Deli Linz",
	"Jack the Ripperl",
	"Burgerista",
	"Spice Club",
	"22k Pizza",
	"Gelbes Krokodil",
	"Vapiano",
	"Mr Wen",
	"Pattaya Thai Restaurant",
	"Nosh",
	"Coconut"
].toSorted()

const locks = await Astro.callAction(actions.locking2026.getLocks, { eventId: 'ImploParty2026' })

function isLocked() {
	if (locks.data === undefined) {
		return false
	}

	return locks.data.voting
}

---

<DefaultLayout title="Implo Party Invite 2026">
	<div class="viewport">
		<main class={isLocked() ? 'locked window' : 'window'}>
			{ isLocked() ? <>Vote is Locked now</> : <></> }
			<Vote client:load restaurants={restaurants} />
		</main>
	</div>
</DefaultLayout>

<style is:global lang="scss">
	@use '../../../styles/pixel/pixel';
	@use '../../../styles/pixel/vote';
</style>
